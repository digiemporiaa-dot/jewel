# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/maya?schema=public"

# NextAuth v5 (Auth.js)
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# The same origin, read at runtime. NEXT_PUBLIC_ values are baked into the bundle
# at build time, so a shop that changes domain — or a resale deployment pointed at
# a new one — keeps emitting canonicals for the old host until somebody rebuilds.
# SITE_URL is checked first, so the domain is correctable without a rebuild.
SITE_URL=""

# ─── Payments — Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Shipping — Shiprocket ───────────────────────────────────────────────────
# Leave EMAIL/PASSWORD blank to run the shipping layer in simulated dev mode.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Shared secret for the tracking webhook (sent as x-api-key).
SHIPROCKET_WEBHOOK_TOKEN=""
# Pickup origin used for serviceability + shipment creation.
SHIPROCKET_PICKUP_PINCODE="110005"
SHIPROCKET_PICKUP_LOCATION="Primary"

# ─── Email — SMTP / Resend ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Maya Jewellers <noreply@example.com>"

# ─── Storage — Cloudflare R2 / S3-compatible ─────────────────────────────────
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ─── OTP delivery — SMS ──────────────────────────────────────────────────────
# Customers sign in by phone OTP, so with no provider configured nobody can log
# in or check out as a returning customer. "console" prints the code to the
# server log, which is the dev default and must never be used in production.
SMS_PROVIDER="console"           # console | msg91
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
# Comma-separated numbers whose OTP is written to the log even when a real
# provider is configured — for a tester who cannot receive SMS. Leave blank in
# production: any number listed here can be signed into without an SMS.
OTP_DEBUG_PHONES=""

# ─── Internal service calls ──────────────────────────────────────────────────
# Edge middleware cannot reach Prisma, so it fetches the redirect map and the
# CSP host list from internal route handlers. Defaults to the request's own
# origin; set this only when the container must call itself by another address.
INTERNAL_BASE_URL=""

# ─── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET="generate-with: openssl rand -hex 32"
# NOTHING CALLS THESE BY ITSELF. A scheduler must hit each endpoint with
# `Authorization: Bearer $CRON_SECRET`, or the shop keeps selling at whatever
# metal rate was last entered by hand, and abandoned-cart, birthday, back-in-stock
# and price-drop mail is never sent:
#   /api/cron/recompute-prices          hourly
#   /api/cron/abandoned-cart            hourly
#   /api/cron/campaigns                 daily
#   /api/cron/shipment-reconciliation   every 6 hours

# ─── Serverless (Vercel) ─────────────────────────────────────────────────────
# Rate limiting is per-process. On Vercel each request may hit a different
# isolate, so a SHARED store is required for limits to mean anything. Create a
# free Upstash Redis database and paste its REST credentials here.
# Leave blank on a single always-on container (Docker/Coolify) — memory is fine.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Extra hostnames permitted through next/image, comma-separated. R2_PUBLIC_URL and
# R2_ENDPOINT are added automatically. Leave blank to allow any https host (only
# safe when you are not paying per optimized image).
IMAGE_HOSTS=""
