# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/maya?schema=public"

# NextAuth v5 (Auth.js)
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Payments — Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Shipping — Shiprocket ───────────────────────────────────────────────────
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_WEBHOOK_TOKEN=""

# ─── Email — SMTP / Resend ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Maya Jewellers <noreply@example.com>"

# ─── Storage — Cloudflare R2 / S3-compatible ─────────────────────────────────
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ─── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET="generate-with: openssl rand -hex 32"
