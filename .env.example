# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/maya?schema=public"

# NextAuth v5 (Auth.js)
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Payments — Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Shipping — Shiprocket ───────────────────────────────────────────────────
# Leave EMAIL/PASSWORD blank to run the shipping layer in simulated dev mode.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Shared secret for the tracking webhook (sent as x-api-key).
SHIPROCKET_WEBHOOK_TOKEN=""
# Pickup origin used for serviceability + shipment creation.
SHIPROCKET_PICKUP_PINCODE="110005"
SHIPROCKET_PICKUP_LOCATION="Primary"

# ─── Email — SMTP / Resend ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Maya Jewellers <noreply@example.com>"

# ─── Storage — Cloudflare R2 / S3-compatible ─────────────────────────────────
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ─── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET="generate-with: openssl rand -hex 32"

# ─── Serverless (Vercel) ─────────────────────────────────────────────────────
# Rate limiting is per-process. On Vercel each request may hit a different
# isolate, so a SHARED store is required for limits to mean anything. Create a
# free Upstash Redis database and paste its REST credentials here.
# Leave blank on a single always-on container (Docker/Coolify) — memory is fine.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Extra hostnames permitted through next/image, comma-separated. R2_PUBLIC_URL and
# R2_ENDPOINT are added automatically. Leave blank to allow any https host (only
# safe when you are not paying per optimized image).
IMAGE_HOSTS=""
