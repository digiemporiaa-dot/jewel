    { "path": "/api/cron/recompute-prices", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/shipment-reconciliation", "schedule": "0 * * * *" },
    { "path": "/api/cron/abandoned-cart", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/campaigns", "schedule": "30 3 * * *" }
  ]
}
